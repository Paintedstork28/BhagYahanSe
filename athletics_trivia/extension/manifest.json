{
  "manifest_version": 3,
  "name": "BhagYahanSe",
  "version": "1.0.0",
  "description": "India ka athletics tracker — trivia, results, and medal alerts",
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "BhagYahanSe"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
